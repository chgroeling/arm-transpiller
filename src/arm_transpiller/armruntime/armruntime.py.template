def MemA_read(ctx: Context, address: int, size: int) -> int:
    return ctx.mem_a_read_hook(ctx, address, size)


def MemA_write(ctx: Context, address: int, size: int, value: int) -> None:
    ctx.mem_a_write_hook(ctx, address, size, value)


def MemU_read(ctx: Context, address: int, size: int) -> int:
    return ctx.mem_u_read_hook(ctx, address, size)


def MemU_write(ctx: Context, address: int, size: int, value: int) -> None:
