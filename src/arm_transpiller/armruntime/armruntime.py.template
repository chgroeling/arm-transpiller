# --- Bit manipulation builtins ---


def UInt(x: int) -> int:
    return x & 0xFFFFFFFF


def Zeros(n: int) -> int:
    return 0


def Ones(n: int) -> int:
    return (1 << n) - 1


def Replicate(x: int, n: int, width: int) -> int:
    result = 0
    for i in range(n):
        result = (result << width) | x
    return result


def concat_bits(left: int, right: int, right_width: int) -> int:
    return (left << right_width) | (right & ((1 << right_width) - 1))


def BitCount(x: int) -> int:
    return x.bit_count()


def IsZeroBit(x: int) -> bool:
    return x == 0


# --- Sign/zero extension ---


def SignExtend(x: int, src_width: int) -> int:
    v = int(x) & ((1 << src_width) - 1)
    if v & (1 << (src_width - 1)):
        v -= 1 << src_width
    return v


def ZeroExtend(x: int, n: int) -> int:
    mask = (1 << n) - 1
    return x & mask


def SInt(x: int, n: int = 32) -> int:
    sign_bit = 1 << (n - 1)
    if x & sign_bit:
        return x - (1 << n)
    return x


# --- Alignment ---


def Align(x: int, alignment: int) -> int:
    return x & ~(alignment - 1)


# --- Architectural state ---


class Apsr:
    def __init__(self) -> None:
        self.N = 0
        self.Z = 0
        self.C = 0
        self.V = 0


class Context:
    def __init__(self) -> None:
        self.apsr = Apsr()
        self.fpscr = 0
        self.istate = 0
        self.user_data = None
        self.mem_a_read_hook = lambda ctx, addr, size: 0
        self.mem_a_write_hook = lambda ctx, addr, size, value: None
        self.mem_u_read_hook = lambda ctx, addr, size: 0
        self.mem_u_write_hook = lambda ctx, addr, size, value: None


def ConditionPassed() -> bool:
