# --- Side-effect bitfield ---

SIDEFFECT_NONE = 0
SIDEFFECT_UNPREDICTABLE = 1 << 0
SIDEFFECT_UNDEFINED = 1 << 1
SIDEFFECT_SEE = 1 << 2


# --- Shift type constants ---

SRType_None = 0
SRType_LSL = 1
SRType_LSR = 2
SRType_ASR = 3
SRType_ROR = 4
SRType_RRX = 5


# --- Shift helpers ---


def DecodeImmShift(type_val: int, imm: int) -> tuple[int, int]:
    type_val = int(type_val)
    imm = int(imm)
    if type_val == 0b00:
        return (SRType_LSL, imm)
    if type_val == 0b01:
        return (SRType_LSR, 32 if imm == 0 else imm)
    if type_val == 0b10:
        return (SRType_ASR, 32 if imm == 0 else imm)
    if imm == 0:
        return (SRType_RRX, 1)
    return (SRType_ROR, imm)


def Shift(value: int, shift_t: int, shift_n: int, carry_in: int) -> int:
    return value


def Shift_C(reg: int, shift_t: int, shift_n: int, old_carry: int) -> tuple[int, int]:
    return (0, 0)


# --- Thumb expand with carry ---


def ThumbExpandImm_C(sideffects: int, val: int, carry_in: int) -> tuple[int, int]:
    val = int(val)
    if (val >> 10) & 0b11 == 0b00:
        control = (val >> 8) & 0b11
        imm8 = val & 0xFF
        if control == 0b00:
            imm32 = imm8
        elif control == 0b01:
            if imm8 == 0:
                sideffects |= SIDEFFECT_UNPREDICTABLE
            imm32 = (imm8 << 16) | imm8
        elif control == 0b10:
            if imm8 == 0:
                sideffects |= SIDEFFECT_UNPREDICTABLE
            imm32 = (imm8 << 24) | (imm8 << 8)
        else:
            if imm8 == 0:
                sideffects |= SIDEFFECT_UNPREDICTABLE
            imm32 = (imm8 << 24) | (imm8 << 16) | (imm8 << 8) | imm8
        carry_out = carry_in
    else:
        unrotated = (1 << 7) | (val & 0x7F)
        shift = (val >> 7) & 0x1F
        imm32 = ((unrotated >> shift) | (unrotated << (32 - shift))) & 0xFFFFFFFF
        carry_out = (imm32 >> 31) & 1
    return (imm32, carry_out)


def ThumbExpandImm(sideffects: int, imm: int) -> int:
    return ThumbExpandImm_C(sideffects, imm, 0)[0]


def VFPExpandImm(imm8: int, n: int) -> int:
    return imm8


